DATABASE_URL="file:./dev.db"
# Segredo que assina a sessão: longo e aleatório (>= 32 caracteres). O app recusa subir com o valor de exemplo.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="troque-por-um-segredo-longo"
# Ao publicar: domínio(s) público(s) do app, sem https://, separados por vírgula.
# Sem isso as Server Actions falham atrás do túnel (o app "lê mas não salva").
# ORIGENS_PERMITIDAS="encomendas.tangaracondominio.com.br"
